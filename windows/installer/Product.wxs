<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
      xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="DeepSeek Harness Glass"
      Manufacturer="etony668"
      Version="$(var.ProductVersion)"
      UpgradeCode="{4B58B12B-5A7A-4DD1-9A3D-0B8D5A8A1F72}"
      Scope="perMachine"
      Language="1033">

    <SummaryInformation Description="DeepSeek Harness Glass Windows desktop application" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of DeepSeek Harness Glass is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="MainFeature" Title="DeepSeek Harness Glass" Level="1">
      <ComponentRef Id="ApplicationPayload" />
      <ComponentRef Id="InstallerScripts" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeepSeek Harness Glass" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DeepSeek Harness Glass" />
    </StandardDirectory>
  </Package>

  <Fragment>
    <Component Id="ApplicationPayload" Directory="INSTALLFOLDER">
      <File Id="ApplicationPayloadZip"
            Source="!(bindpath.PayloadDir)\DeepSeekHarnessGlass-payload.zip"
            KeyPath="yes" />
    </Component>

    <Component Id="InstallerScripts" Directory="INSTALLFOLDER">
      <File Id="InstallPayloadScript" Source="!(bindpath.InstallerDir)\install-runtime.ps1" />
      <File Id="RemovePayloadScript" Source="!(bindpath.InstallerDir)\remove-runtime.ps1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder">
      <Shortcut
          Id="StartMenuShortcut"
          Name="DeepSeek Harness Glass"
          Description="Open DeepSeek Harness Glass"
          Target="[INSTALLFOLDER]DeepSeekHarnessGlass.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\DeepSeek Harness Glass"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <SetProperty
        Id="ExtractApplicationPayload"
        Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#InstallPayloadScript]&quot; -ArchivePath &quot;[#ApplicationPayloadZip]&quot; -DestinationPath &quot;[INSTALLFOLDER]&quot;"
        Before="ExtractApplicationPayload"
        Sequence="execute" />
    <CustomAction
        Id="ExtractApplicationPayload"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <SetProperty
        Id="RemoveExtractedApplication"
        Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#RemovePayloadScript]&quot; -InstallRoot &quot;[INSTALLFOLDER]&quot; -CurrentScriptPath &quot;[#RemovePayloadScript]&quot;"
        Before="RemoveExtractedApplication"
        Sequence="execute" />
    <CustomAction
        Id="RemoveExtractedApplication"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="ExtractApplicationPayload" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RemoveExtractedApplication" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
